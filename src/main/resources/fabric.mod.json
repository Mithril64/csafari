{
  "schemaVersion": 1,
  "id": "critter-safari-timer",
  "version": "${version}",
  "name": "Critter Safari Timer",
  "description": "Times your Critter Safari runs, tracks unique critters caught, and alerts you (sound/chat/HUD) for Miria's contest.",
  "authors": ["you"],
  "license": "MIT",
  "icon": "assets/csafari/icon/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.xispana.safari.SafariTimerClient"
      }
    ]
  },
  "mixins": [
    "csafari.mixins.json",
    "csafari-optional.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.13",
    "minecraft": ">=26.1.2",
    "java": ">=25"
  }
}
